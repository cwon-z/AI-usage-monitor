# Run the secret export utility first. This is the only Android credential.
WIDGET_API_TOKEN_FILE=/run/secrets/widget-api-token

DATABASE_URL=sqlite:////data/usage.db
COLLECTION_INTERVAL_SECONDS=600
RETENTION_DAYS=30
STALE_AFTER_SECONDS=1800
MANUAL_REFRESH_MIN_INTERVAL_SECONDS=60
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_RETRY_ATTEMPTS=3
PROVIDER_RETRY_BASE_SECONDS=0.5
LOG_LEVEL=INFO

CLAUDE_ENABLED=true
CLAUDE_CLI_PATH=claude
CLAUDE_CREDENTIALS_FILE=/run/secrets/claude-credentials.json

CODEX_ENABLED=true
CODEX_CLI_PATH=codex
CODEX_AUTH_FILE=/run/secrets/codex-auth.json

# Native Linux: set these to the owner of the secrets directory (id -u / id -g).
APP_UID=10001
APP_GID=10001
SECRETS_DIR=./secrets
